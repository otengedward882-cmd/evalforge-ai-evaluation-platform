# Environment Configuration Template
PROJECT_NAME="EvalForge"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication (Replace in production)
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL for Docker/Production, SQLite fallback for local dev)
# DATABASE_URL="postgresql+psycopg2://evalforge_user:evalforge_password@localhost:5432/evalforge_db"
DATABASE_URL="sqlite:///./evalforge.db"

# CORS Configuration (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
